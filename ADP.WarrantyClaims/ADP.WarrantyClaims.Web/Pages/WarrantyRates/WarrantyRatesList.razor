@attribute [Authorize]
@attribute [Route($"/{nameof(WarrantyRatesList)}")]

@* The warranty-rates admin list. Rates rows are create-only audit rows, so the list stays
   ID-only, newest first. *@

@inject IOptions<WarrantyClaimsWebOptions> WCOptions
@inject IWarrantyClaimsCapabilityProvider CapabilityProvider

<ShiftList EntitySet="WarrantyRates"
           Title="Warranty Rates"
           T="WarrantyRatesListDTO"
           Dense
           DisableActionColumn
           ComponentType="typeof(WarrantyRatesForm)"
           ShowIDColumn="true"
           HighlightSortedColumn
           TypeAuthAction="WCOptions.Value.WarrantyRatesAction"
           EnableExport>
    <ToolbarStartTemplate>
        <MudButton Href="@($"/{nameof(WarrantyCurrencyRateList)}")"
                   Variant="Variant.Outlined"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.CurrencyExchange">
            Currency Rates
        </MudButton>

        @if (CapabilityProvider.IsDistributor)
        {
            <MudButton Href="@($"/{nameof(WarrantyLaborRateList)}")"
                       Variant="Variant.Outlined"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Engineering">
                Labor Rates
            </MudButton>
        }
    </ToolbarStartTemplate>

    <ChildContent>
        <Sort Property="x => x.ID" Direction="SortDirection.Descending" />
    </ChildContent>
</ShiftList>
