<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<AssemblyName>ADP.Menus.Tests</AssemblyName>
		<RootNamespace>ShiftSoftware.ADP.Menus.Tests</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit.v3" Version="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="coverlet.collector" Version="10.0.1">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<!-- For the opt-in Cosmos provisioning test. Most tests here are pure and offline. -->
		<PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.0" />

		<!--
		  For the opt-in sample-data seeding test, which writes the demo catalogue into the sample's SQL
		  database. ShiftIdentity.Data supplies ShiftIdentityDbContext and the Brand entity, so
		  SampleSeedDB can reproduce the sample API's model without referencing the web app itself.
		-->
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
		<PackageReference Include="ShiftSoftware.ShiftIdentity.Data" Version="2026.7.31.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ADP.Menus.Data\ADP.Menus.Data.csproj" />
		<ProjectReference Include="..\ADP.Menus.Generation\ADP.Menus.Generation.csproj" />

		<!--
		  The vehicle lookup's read side. It lives here rather than in Lookup.Services.Tests because the
		  test that matters most is DIFFERENTIAL — it runs one menu graph through the DMS export and
		  through the whole replicate-then-read path and compares the menu codes. That comparison needs
		  both sides visible in one assembly, and this project already has the export side and the
		  fixtures. It is also the project CI runs.
		-->
		<ProjectReference Include="..\..\ADP.LookupServices\Lookup.Services\Lookup.Services.csproj" />
	</ItemGroup>

</Project>
