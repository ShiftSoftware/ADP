@inject global::ShiftSoftware.ADP.Menus.Web.Services.MenuAuthService MenuAuth

@* Visibility goes through MenuAuthService, NOT through AuthorizedMudNavLink's direct TypeAuth check.
   MenuActionTree authorization is OPT-IN (MenuWebOptions.EnableMenuActionTreeAuthorization, default
   false), and a consumer that leaves it off need not — and typically does not — register
   MenuActionTree with TypeAuth at all. Gating straight on TypeAuth therefore hid every link in exactly
   the configuration the module ships as its default. MenuAuthService returns true for everything when
   authorization is disabled, and defers to TypeAuth when it is enabled, so both modes behave. *@

<MudNavLink Href="@MenuRoutes.Prefix"
            Match="NavLinkMatch.All"
            IconColor="Color.Primary"
            Icon="@Icons.Material.Filled.Dashboard">
    Overview
</MudNavLink>

@if (MenuAuth.CanReadMenus)
{
    <MudNavLink Href="@(MenuRoutes.Prefix + "/" + nameof(Pages.Menu.MenuList))"
                Match="NavLinkMatch.All"
                IconColor="Color.Primary"
                Icon="@Icons.Material.Filled.MenuBook">
        Menus
    </MudNavLink>
}

