<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\GlobalSettings.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>ShiftSoftware.ADP.Menus.Data</RootNamespace>
		<Authors>Shift Software</Authors>
		<Product>ADP.Menus</Product>
		<Version>$(ADPVersion)</Version>
		<AssemblyName>ShiftSoftware.ADP.Menus.Data</AssemblyName>
		<PackageId>ShiftSoftware.ADP.Menus.Data</PackageId>
		<Title>ShiftSoftware ADP.Menus — Data</Title>
		<Description>Entities, repositories, AutoMapper profiles and export services for the ShiftSoftware ADP.Menus package — an automotive service menu (parts &amp; labour) module.</Description>
		<Copyright>Copyright (c) Shift Software 2026</Copyright>
		<PackageProjectUrl>https://github.com/ShiftSoftware/ADP</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<RepositoryUrl>https://github.com/ShiftSoftware/ADP</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>shift;shiftsoftware;adp;menus;automotive;service;parts;labour;efcore</PackageTags>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Images\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ADP.Menus.Shared\ADP.Menus.Shared.csproj" />
		<!--
		  The shared, source-agnostic menu-code generator. The export aggregates its EF graph into the
		  generator's neutral request model rather than generating codes itself, so the DMS export and
		  the vehicle lookup cannot drift. See COSMOS_REPLICATION_PLAN.md §1.1.
		-->
		<ProjectReference Include="..\ADP.Menus.Generation\ADP.Menus.Generation.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ShiftSoftware.ShiftEntity.EFCore" Version="2026.7.31.1" />
		<PackageReference Include="ShiftSoftware.ShiftIdentity.Core" Version="2026.7.31.1" />
		<!--
		  Cosmos replication of the menu catalog (Extensions/MenuReplicationExtensions.cs). Opt-in:
		  a consumer that never calls AddMenuReplications replicates nothing.
		-->
		<PackageReference Include="ShiftSoftware.ShiftEntity.CosmosDbReplication" Version="2026.7.31.1" />
	</ItemGroup>

	<!--
	  The Cosmos document models (layer 2) live in ADP.Models so both this project and the
	  netstandard2.0 vehicle lookup can see them. Project reference locally, package elsewhere.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\ADP.Models\Models\Models.csproj" Condition="Exists('..\..\ADP.Models\Models\Models.csproj')" />
		<PackageReference Include="ShiftSoftware.ADP.Models" Version="$(ADPVersion)" Condition="!Exists('..\..\ADP.Models\Models\Models.csproj')" />
	</ItemGroup>
</Project>
