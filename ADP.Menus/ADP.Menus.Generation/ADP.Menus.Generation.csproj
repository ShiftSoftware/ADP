<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\GlobalSettings.props" />

	<PropertyGroup>
		<!--
		  netstandard2.0 ON PURPOSE. This assembly holds the menu-code generation logic that BOTH the
		  net10.0 DMS export and the netstandard2.0 vehicle lookup must call. A netstandard2.0 project
		  cannot reference a net10.0 one, so the shared logic cannot live in ADP.Menus.Shared (net10.0).
		  See COSMOS_REPLICATION_PLAN.md §1.2. Do not retarget without re-reading that section.
		-->
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<RootNamespace>ShiftSoftware.ADP.Menus.Generation</RootNamespace>
		<Authors>Shift Software</Authors>
		<Product>ADP.Menus</Product>
		<Version>$(ADPVersion)</Version>
		<AssemblyName>ShiftSoftware.ADP.Menus.Generation</AssemblyName>
		<PackageId>ShiftSoftware.ADP.Menus.Generation</PackageId>
		<IsPackable>true</IsPackable>
		<Title>ShiftSoftware ADP.Menus — Generation</Title>
		<Description>Source-agnostic service-menu code and price generation for the ShiftSoftware ADP.Menus package. Consumers aggregate their own data (EF entities, Cosmos documents) into a neutral request model and receive generated menu lines, so every consumer produces identical menu codes.</Description>
		<Copyright>Copyright (c) Shift Software 2026</Copyright>
		<PackageProjectUrl>https://github.com/ShiftSoftware/ADP</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<RepositoryUrl>https://github.com/ShiftSoftware/ADP</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>shift;shiftsoftware;adp;menus;automotive;service;parts;labour</PackageTags>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Images\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!--
	  Deliberately dependency-light: POCO models + pure logic only. No FluentValidation, no EF. The
	  lookup takes a hard dependency on this assembly, so anything added here is added to the lookup too.
	-->
	<ItemGroup>
		<PackageReference Include="System.Text.Json" Version="10.0.10" />
	</ItemGroup>

	<!--
	  ADP.Models, for the layer-2 Cosmos document types that CosmosToGenerationAggregator reads
	  (COSMOS_REPLICATION_PLAN.md §1.2/§2.1). One-way: ADP.Models knows nothing about menus.

	  Note this is not quite as free as §2.1 assumed — ADP.Models itself carries ShiftEntity.Model,
	  FileHelpers, libphonenumber and BouncyCastle. It costs the two real consumers nothing (the DMS
	  export and the vehicle lookup both already reference ADP.Models), but a consumer that wanted ONLY
	  the pure generator now pulls that chain too. Accepted deliberately: the alternative is a third
	  package for one file, or duplicating the adapter in every Cosmos consumer.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\ADP.Models\Models\Models.csproj"
		                  Condition="Exists('..\..\ADP.Models\Models\Models.csproj')" />
		<PackageReference Include="ShiftSoftware.ADP.Models" Version="$(ADPVersion)"
		                  Condition="!Exists('..\..\ADP.Models\Models\Models.csproj')" />
	</ItemGroup>

</Project>
