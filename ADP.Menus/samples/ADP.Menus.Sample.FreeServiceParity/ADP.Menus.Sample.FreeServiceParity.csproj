<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ShiftSoftware.ADP.Menus.Sample.FreeServiceParity</RootNamespace>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!--
	  A SAMPLE, deliberately: the matching rules, report models and rendering live here, in menu-land,
	  because they encode one deployment question — "does the menu generate the same free services the
	  manually-filled service-items system holds?" — not reusable lookup behaviour. The lookup projects
	  contribute only their real public surface (bulk lookup, VIN enumeration, the service-items
	  report's dedup semantics).

	  The audit composes that stack by hand (storage → menu lookup → vehicle lookup) instead of going
	  through AddLookupService, because that registration hard-requires a CosmosClient the audit never
	  uses — everything here reads one DuckDB file.
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\..\ADP.LookupServices\Lookup.Services\Lookup.Services.csproj" />
		<ProjectReference Include="..\..\..\ADP.LookupServices\Lookup.Services.DuckDB\Lookup.Services.DuckDB.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
	</ItemGroup>
</Project>
