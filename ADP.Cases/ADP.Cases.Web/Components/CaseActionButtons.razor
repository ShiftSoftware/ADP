@typeparam T where T : ShiftEntityViewAndUpsertDTO, new()
@typeparam TStatus where TStatus : struct, Enum
@typeparam TTrigger where TTrigger : struct, Enum

@* The actions on a case, for the start of its form's header: one button per move the case type's definition gives Role
   from the case's current status, and "Add Note" when the definition allows it. *@

@if (Visible)
{
    <MudStack Row Spacing="2" AlignItems="AlignItems.Center" Class="ms-2" Style="min-width: 0; overflow-x: auto; white-space: nowrap;">
        @foreach (var trigger in Definition.ActionsFrom(Status, Role).OrderBy(t => CaseActionLook.Of(t.ToString()).Order))
        {
            var look = CaseActionLook.Of(trigger.ToString());
            var label = trigger.Describe();
            var to = MovesTo(trigger);

            <FormActionButton @key="trigger"
                              T="T"
                              Endpoint="@($"{Endpoint}/{Id}/action/{trigger}")"
                              Body="@(() => new CaseActionDTO { Comment = comment })"
                              OnBeforeDialogOpen="ClearCommentAsync"
                              Confirm
                              DialogTitle="@($"{label} — {CaseName}")"
                              DialogIcon="@look.Icon"
                              DialogColor="@look.Color"
                              DialogConfirmText="@label"
                              TaskSuccessMessage="@($"{CaseName} is now {to}.")"
                              Color="@look.Color"
                              StartIcon="@look.Icon"
                              Class="flex-shrink-0">
                <DialogBodyTemplate>
                    <MudText Typo="Typo.body2" Class="mb-4">
                        The @Definition.Noun moves to <strong>@to</strong>, and this goes on its history.
                    </MudText>
                    <MudTextField T="string"
                                  @bind-Value="comment"
                                  Label="Response"
                                  Lines="4"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  HelperText="@ResponseHelp" />
                </DialogBodyTemplate>
                <ChildContent>@label</ChildContent>
            </FormActionButton>
        }

        @if (Definition.CanAddNote(Status, Role))
        {
            var look = CaseActionLook.Of("Note");

            <FormActionButton T="T"
                              Endpoint="@($"{Endpoint}/{Id}/note")"
                              Body="@(() => new CaseActionDTO { Comment = comment })"
                              OnBeforeDialogOpen="ClearCommentAsync"
                              Confirm
                              DialogTitle="@($"Add Note — {CaseName}")"
                              DialogIcon="@look.Icon"
                              DialogColor="Color.Primary"
                              DialogConfirmText="Add Note"
                              TaskSuccessMessage="@($"Note added to {CaseName}.")"
                              Color="@look.Color"
                              StartIcon="@look.Icon"
                              Class="flex-shrink-0">
                <DialogBodyTemplate>
                    <MudText Typo="Typo.body2" Class="mb-4">
                        This goes on the @Definition.Noun's history. The status does not change.
                    </MudText>
                    <MudTextField T="string"
                                  @bind-Value="comment"
                                  Label="Note"
                                  Lines="4"
                                  Variant="Variant.Outlined"
                                  Immediate="true"
                                  Required="true" />
                </DialogBodyTemplate>
                <ChildContent>Add Note</ChildContent>
            </FormActionButton>
        }
    </MudStack>
}

@code {
    /// <summary>The case type's rules.</summary>
    [Parameter, EditorRequired]
    public CaseDefinition<TStatus, TTrigger> Definition { get; set; } = default!;

    /// <summary>The case type's endpoint, relative to the API's base address.</summary>
    [Parameter, EditorRequired]
    public string Endpoint { get; set; } = default!;

    /// <summary>The case the form shows.</summary>
    [Parameter, EditorRequired]
    public string? Id { get; set; }

    /// <summary>The stored status of that case.</summary>
    [Parameter]
    public TStatus? Status { get; set; }

    /// <summary>Whose buttons these are: <see cref="CaseRoles.Distributor"/> or <see cref="CaseRoles.Dealer"/>.</summary>
    [Parameter]
    public string? Role { get; set; }

    /// <summary>How the case is named in the dialog and the snackbar, for example "Report #8164".</summary>
    [Parameter, EditorRequired]
    public string CaseName { get; set; } = default!;

    /// <summary>Whether to show any buttons: a saved case, in View mode, for someone who may act on it.</summary>
    [Parameter]
    public bool Visible { get; set; }

    /// <summary>What the distributor is called in a sentence.</summary>
    [Parameter]
    public string DistributorName { get; set; } = "the distributor";

    private string? comment;

    private string ResponseHelp => Role == CaseRoles.Dealer
        ? $"Optional. Shown to {DistributorName} in the history."
        : "Optional. Shown to the dealer in the history.";

    private string MovesTo(TTrigger trigger) =>
        Definition.Transitions.First(t => EqualityComparer<TStatus>.Default.Equals(t.From, Status!.Value)
                                          && EqualityComparer<TTrigger>.Default.Equals(t.Trigger, trigger)).To.Describe();

    private ValueTask<bool> ClearCommentAsync()
    {
        comment = null;
        return ValueTask.FromResult(true);
    }
}
