<Project Sdk="Microsoft.NET.Sdk.Razor">
	<Import Project="..\..\GlobalSettings.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ShiftSoftware.ADP.Cases.Web</RootNamespace>
		<BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
		<Authors>Shift Software</Authors>
		<Product>ADP.Cases</Product>
		<Version>$(ADPVersion)</Version>
		<AssemblyName>ShiftSoftware.ADP.Cases.Web</AssemblyName>
		<PackageId>ShiftSoftware.ADP.Cases.Web</PackageId>
		<Title>ShiftSoftware ADP.Cases — Web</Title>
		<Description>Blazor components for the case and claim forms and lists of the ShiftSoftware ADP.Cases package — the action buttons, the status history and the draft box.</Description>
		<PackageProjectUrl>https://github.com/ShiftSoftware/ADP</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<RepositoryUrl>https://github.com/ShiftSoftware/ADP</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>shift;shiftsoftware;adp;cases;claims;workflow;automotive;blazor</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Images\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
		<PackageReference Include="ShiftSoftware.ShiftBlazor" Version="2026.11.22.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ADP.Cases.Shared\ADP.Cases.Shared.csproj" />
	</ItemGroup>
</Project>
