<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\GlobalSettings.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<NoWarn>$(NoWarn);NU1701</NoWarn>
		<RootNamespace>ShiftSoftware.ADP.Cases.API</RootNamespace>
		<Authors>Shift Software</Authors>
		<Product>ADP.Cases</Product>
		<Version>$(ADPVersion)</Version>
		<AssemblyName>ShiftSoftware.ADP.Cases.API</AssemblyName>
		<PackageId>ShiftSoftware.ADP.Cases.API</PackageId>
		<Title>ShiftSoftware ADP.Cases — API</Title>
		<Description>The ASP.NET Core controller base for case types of the ShiftSoftware ADP.Cases package — the action, batch-action and note endpoints.</Description>
		<PackageProjectUrl>https://github.com/ShiftSoftware/ADP</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<RepositoryUrl>https://github.com/ShiftSoftware/ADP</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>shift;shiftsoftware;adp;cases;claims;workflow;automotive;aspnetcore</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Images\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="ShiftSoftware.ShiftEntity.Web" Version="2026.11.22.1" />
		<PackageReference Include="ShiftSoftware.TypeAuth.AspNetCore" Version="2.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ADP.Cases.Data\ADP.Cases.Data.csproj" />
	</ItemGroup>

</Project>
