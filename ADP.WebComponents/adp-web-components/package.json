{
  "name": "adp-web-components",
  "version": "0.3.19",
  "description": "ADP Platform Web Components",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/shift-components/shift-components.esm.js",
  "exports": {
    ".": {
      "import": "./dist/shift-components/shift-components.esm.js",
      "require": "./dist/shift-components/shift-components.cjs.js"
    },
    "./my-component": {
      "import": "./dist/components/my-component.js",
      "types": "./dist/components/my-component.d.ts"
    },
    "./components/*": {
      "import": "./dist/components/*.js",
      "types": "./dist/components/*.d.ts"
    },
    "./host-loader": {
      "import": "./dist/host-loader.js"
    },
    "./integration-manifest": "./dist/integration-manifest.json",
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ShiftSoftware/adp-web-components"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "test": "stencil test --spec",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck:ts7": "npx --yes -p typescript@7 tsc --noEmit -p tsconfig.json",
    "generate": "stencil generate",
    "build": "stencil build -- --prod && node ./automation/generate-integration-manifest.mjs",
    "start": "node ./automation/dev.mjs",
    "test.watch": "stencil test --spec --watchAll",
    "create:type": "node ./automation/generate-type.mjs",
    "update:locale": "node ./automation/update-locale.mjs",
    "delete:locale": "node ./automation/delete-locale.mjs",
    "create:locale": "node ./automation/generate-locale.mjs",
    "create:locale-mapper": "node ./automation/generate-locale-mapper.mjs",
    "purge": "node ./automation/purge-cdn.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,scss,html}\"",
    "prettier": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,scss,html}\"",
    "generate:integration-manifest": "node ./automation/generate-integration-manifest.mjs",
    "verify:integration-artifact": "node ./automation/verify-integration-artifact.mjs",
    "build:templates": "node ./automation/build-templates.mjs",
    "watch:templates": "node ./automation/build-templates.mjs --watch",
    "start:stencil": "stencil build --dev --watch --serve"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-alias": "^5.1.1",
    "@stencil/core": "^4.43.5",
    "@stencil/postcss": "^2.1.0",
    "@stencil/sass": "^2.0.0",
    "@tailwindcss/cli": "^4",
    "@types/jest": "29",
    "@types/node": "^22.10.0",
    "alpinejs": "^3",
    "autoprefixer": "^10.4.13",
    "cssnano": "^5.1.14",
    "daisyui": "^5",
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "jest": "29",
    "jest-cli": "29",
    "prettier": "^3.5.3",
    "stencil-tailwind-plugin": "^1.8.0",
    "tailwindcss": "^3.2.4",
    "tailwindcss4": "npm:tailwindcss@^4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.1.1",
    "countries-and-timezones": "^3.8.0",
    "date-fns": "^4.1.0",
    "libphonenumber-js": "^1.12.34",
    "tailwind-merge": "^2.5.5",
    "yup": "^1.5.0"
  }
}
