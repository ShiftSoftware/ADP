          <svg class="dialog-close-icon-button-icon" fill="none" part="dialog-close-icon-button-icon" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
