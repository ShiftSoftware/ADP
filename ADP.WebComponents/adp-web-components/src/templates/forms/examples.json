      "component": "service-booking-form",
      "label": "Plain",
      "blurb": "One step, with the fields a workshop needs: a VIN validated by its check digit, a year select built from min and max, and a time select generated every 30 minutes between 09:00 and 17:00. The branch is pinned with staticValue — that is how a select which normally calls an endpoint renders without one.",
      "submitMode": "render-only",
      "defaultTheme": "bordered",
      "structure": {
        "data": {
          "requestUrl": "https://example.invalid/api/tickets",
          "theme": "docs-preset",
          "truncatedFields": {
            "bookingDate": ["date", " ", "time"],
            "parse date: bookingDate": "yyyy-MM-dd HH:mm",
            "format date: bookingDate": "iso",
            "plateNumber": "PlateNumber",
            "time": "PreferredTime",
            "modelYear": ["year"]
          },
          "localization": {
            "en": {
              "submit": "Request booking",
              "Form submitted successfully.": "Booking request received."
            }
