{
  "$note": [
    "Presets for the ticket-forms documentation page.",
    "",
    "Exactly TWO per form type: a plain one and a stepped one. Everything else a",
    "supplier needs to see — extra fields, a custom field name, a multi-country",
    "phone — is folded into those two rather than spun off into more examples.",
    "",
    "Every preset is SELF-CONTAINED: the structure is inline, so it renders with no",
    "network call and no deployment behind it. 'render-only' means the submit button",
    "validates and then stops at a notice instead of POSTing, which is why every",
    "requestUrl points at example.invalid.",
    "",
    "The themes here are the page's own demonstration stylesheets, not something the",
    "package ships. A host writes its own; these exist so the page has something",
    "real to show.",
    "",
    "Never add a recaptchaKey. A placeholder key looks healthy until someone presses",
    "Submit, then fails with 'Invalid site key'. Omitting it is the documented default."
  ],
  "themes": [
    {
      "id": "compact",
      "label": "Compact",
      "css": "themes/compact.css"
    },
    {
      "id": "bordered",
      "label": "Bordered",
      "css": "themes/bordered.css"
    },
    {
      "id": "dark",
      "label": "Dark",
      "css": "themes/dark.css"
    }
  ],
  "presets": [
    {
      "id": "general-inquiry-basic",
      "group": "general-inquiry",
      "component": "general-inquiry-form",
      "label": "Plain",
      "blurb": "One step. The topic is a select whose options come from the structure, and the phone field is limited to a set of countries. orderReference is not on the field-name allow-list: type points at a name that is, so it renders as a text field.",
      "submitMode": "render-only",
      "defaultTheme": "bordered",
      "structure": {
        "data": {
          "requestUrl": "https://example.invalid/api/tickets",
          "requestMethod": "POST",
          "theme": "docs-preset",
          "localization": {
            "en": {
              "submit": "Send",
              "Form submitted successfully.": "Thanks — we will be in touch."
            },
            "ar": {
              "submit": "إرسال",
              "Form submitted successfully.": "تم الإرسال بنجاح."
            }
          },
          "truncatedFields": {
            "orderReference": "OrderReference"
          },
          "brandId": "<your-brand-id>"
        },
        "requiredContext": {
          "name": true,
          "email": true,
          "message": true,
          "generalTicketType": true
        },
        "tag": "div",
        "id": "container",
        "children": [
          {
            "tag": "h2",
            "class": "section-title",
            "children": {
              "en": "How can we help?",
              "ar": "كيف يمكننا المساعدة؟"
            }
          },
          {
            "name": "generalTicketType",
            "options": [
              {
                "value": "GeneralInquiry",
                "en": "General inquiry",
                "ar": "استفسار عام"
              },
              {
                "value": "Complaint",
                "en": "Complaint",
                "ar": "شكوى"
              },
              {
                "value": "PartInquiry",
                "en": "Parts",
                "ar": "قطع غيار"
              },
              {
                "value": "ServicePriceInquiry",
                "en": "Service pricing",
                "ar": "أسعار الصيانة"
              }
            ],
            "localization": {
              "en": {
                "label": "What is this about?",
                "placeholder": "Choose a topic",
                "require": "Please choose a topic."
              }
            }
          },
          {
            "tag": "div",
            "id": "inputs_wrapper",
            "children": [
              {
                "name": "name",
                "localization": {
                  "en": {
                    "label": "Full name",
                    "placeholder": "Full name",
                    "require": "Full name is required."
                  }
                }
              },
              {
                "name": "email",
                "localization": {
                  "en": {
                    "label": "Email",
                    "placeholder": "you@example.invalid",
                    "require": "Email is required."
                  }
                }
              },
              {
                "name": "phone",
                "countryCode": ["IQ", "AE", "SA", "JO", "TR", "GB"],
                "localization": {
                  "en": {
                    "label": "Phone",
                    "placeholder": "Phone number",
                    "require": "Phone number is required."
                  }
                }
              },
              {
                "name": "orderReference",
                "type": "name",
                "localization": {
                  "en": {
                    "label": "Order reference",
                    "placeholder": "ORD-00000"
                  }
                }
              }
            ]
          },
          {
            "tag": "div",
            "id": "message_wrapper",
            "children": [
              {
                "name": "message",
                "localization": {
                  "en": {
                    "label": "Details",
                    "placeholder": "Tell us what you need",
                    "require": "A message is required."
                  }
                }
              }
            ]
          },
          {
            "name": "submit",
            "localization": {
              "en": {
                "label": "Send"
              }
            }
          }
        ]
      }
    },
