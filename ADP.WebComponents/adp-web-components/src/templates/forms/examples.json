                    "require": "VIN is required.",
                    "format": "That VIN fails its checksum."
                  }
                }
              },
              {
                "name": "year",
                "min": 2005,
                "max": 2026,
                "localization": {
                  "en": {
                    "label": "Model year",
                    "placeholder": "Select a year"
                  }
                }
              },
              {
                "name": "plateNumber",
                "type": "name",
                "localization": {
                  "en": {
                    "label": "Plate number",
                    "placeholder": "Plate number"
                  }
                }
              }
            ]
          },
          {
            "tag": "div",
            "id": "slot_wrapper",
            "children": [
              {
                "name": "date",
                "min": [0, 0, 1],
                "max": [0, 1, 0],
                "localization": {
                  "en": {
                    "label": "Date",
                    "placeholder": "Pick a date",
                    "require": "Date is required.",
                    "minMessage": "Earliest available is $minDate$",
                    "maxMessage": "Latest available is $maxDate$"
                  }
                }
              },
              {
                "name": "time",
                "min": [0, 0, 0, 9, 0],
                "max": [0, 0, 0, 17, 0],
                "span": [0, 0, 0, 0, 30],
                "format": "HH:mm",
                "localization": {
                  "en": {
                    "label": "Time",
                    "placeholder": "Pick a time",
                    "require": "Time is required."
                  }
                }
              }
            ]
          },
          {
            "tag": "div",
            "id": "inputs_wrapper",
            "children": [
              {
                "name": "companyBranchId",
                "staticValue": {
                  "value": "branch-1",
                  "label": "Central service centre"
                },
                "localization": {
                  "en": {
                    "label": "Branch",
                    "placeholder": "Select",
                    "require": "Branch is required."
                  }
                }
              },
              {
                "name": "name",
                "localization": {
                  "en": {
                    "label": "Full name",
                    "placeholder": "Full name",
                    "require": "Full name is required."
                  }
                }
              },
              {
                "name": "phone",
                "countryCode": ["IQ", "AE", "SA", "JO", "TR", "GB"],
                "localization": {
                  "en": {
                    "label": "Phone",
                    "placeholder": "Phone number",
                    "require": "Phone number is required."
                  }
                }
              }
            ]
          },
          {
            "tag": "div",
            "id": "message_wrapper",
            "children": [
              {
                "name": "message",
                "localization": {
                  "en": {
                    "label": "Anything we should know?",
                    "placeholder": "Optional notes"
