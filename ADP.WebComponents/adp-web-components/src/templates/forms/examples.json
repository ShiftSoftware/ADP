        "requiredContext": {
          "name": true,
          "vin": true,
          "date": true,
          "time": true
        },
        "tag": "div",
        "id": "container",
        "children": [
          {
            "tag": "h2",
            "class": "section-title",
            "children": {
              "en": "Book a service",
              "ar": "احجز صيانة"
            }
