{
  "schemaVersion": 1,
  "outputFamily": "per-component",
  "components": {
    "vehicle-lookup": {
      "wireContract": "adp.vehicle-lookup.v1",
      "supportedLocales": ["en", "ar", "ku", "ru"],
      "host": {
        "properties": ["activeElement", "baseUrl", "childrenProps", "disableVinValidation", "hiddenTabs", "language", "queryString", "sscQueryString"],
        "methods": ["fetchVin"],
        "owns": ["vehicle lookup request", "response distribution to child components", "active child rendering"]
      },
      "runtimeAssets": {
        "locales": "dist/locales",
        "notes": [
          "The host owns tab navigation and selects the activeElement.",
          "With sscQueryString set, only a search made from the SSC tab counts as a campaign check; a search from another tab leaves the SSC tab saying the check was not run, with a control to run it. It reaches vehicle-ssc as lookupQueryString, so it never joins a trace request."
        ]
      }
    },
    "vehicle-specification": {
      "wireContract": "adp.vehicle-specification.v1",
      "supportedLocales": ["en", "ar", "ku", "ru"],
      "host": {
        "properties": ["baseUrl", "language", "coreOnly", "disableVinValidation", "queryString"],
        "methods": ["fetchVin"],
        "owns": ["lookup request", "response handling", "loading and error state", "vehicle specification rendering"]
      },
      "runtimeAssets": {
        "locales": "dist/locales",
        "notes": []
      }
    },
    "vehicle-sale-information": {
      "wireContract": "adp.vehicle-sale-information.v1",
      "supportedLocales": ["en", "ar", "ku", "ru"],
      "host": {
        "properties": ["baseUrl", "language", "coreOnly", "disableVinValidation", "hiddenFields", "queryString"],
        "methods": ["fetchVin"],
        "owns": ["lookup request", "response handling", "loading and error state", "sale information rendering"]
      },
      "runtimeAssets": {
        "locales": "dist/locales",
        "notes": ["The host may use hiddenFields to apply its approved presentation policy."]
      }
    },
    "vehicle-accessories": {
      "wireContract": "adp.vehicle-accessories.v1",
      "supportedLocales": ["en", "ar", "ku", "ru"],
      "host": {
        "properties": ["baseUrl", "language", "coreOnly", "disableVinValidation", "queryString"],
        "methods": ["fetchVin"],
        "owns": ["lookup request", "response handling", "loading and error state", "accessory rendering"]
      },
      "runtimeAssets": {
        "locales": "dist/locales",
        "notes": []
      }
    },
    "vehicle-service-history": {
      "wireContract": "adp.vehicle-service-history.v1",
      "supportedLocales": ["en", "ar", "ku", "ru"],
      "host": {
        "properties": ["baseUrl", "language", "coreOnly", "disableVinValidation", "queryString"],
        "methods": ["fetchVin"],
        "owns": ["lookup request", "response handling", "loading and error state", "service-history rendering"]
      },
      "runtimeAssets": {
        "locales": "dist/locales",
        "notes": ["The current package global script loads shared fonts and browser interop helpers."]
      }
    },
    "vehicle-paint-thickness": {
      "wireContract": "adp.vehicle-paint-thickness.v1",
      "supportedLocales": ["en", "ar", "ku", "ru"],
      "host": {
        "properties": ["baseUrl", "language", "coreOnly", "disableVinValidation", "queryString", "showCertificateButton"],
        "methods": ["fetchVin"],
        "owns": ["lookup request", "response handling", "loading and error state", "paint-thickness rendering"]
      },
      "runtimeAssets": {
        "locales": "dist/locales",
        "notes": []
      }
    },
    "vehicle-ssc": {
      "wireContract": "adp.vehicle-ssc.v1",
      "supportedLocales": ["en", "ar", "ku", "ru"],
      "host": {
        "properties": ["baseUrl", "language", "coreOnly", "disableVinValidation", "queryString", "lookupQueryString", "showTrace"],
        "methods": ["fetchVin"],
        "owns": ["lookup request", "response handling", "loading and error state", "campaign rendering", "repair-status trace fetch"]
      },
      "runtimeAssets": {
        "locales": "dist/locales",
        "notes": [
          "Replaces the campaign half of the retired vehicle-warranty-details; warranty coverage is vehicle-warranty-timeline.",
          "Unauthorized campaign lookup and reCAPTCHA configuration are host policy and remain optional raw API properties.",
          "showTrace exposes claim and invoice details per campaign; the host gates it on its own permission check and its endpoint must honour ?trace=ssc.",
          "A lookup-logging flag belongs in lookupQueryString, which joins the lookup request only: the trace request re-reads a lookup already logged and never carries it. The host endpoint must refuse to log traced requests as well (the ADP lookup service does).",
          "Opening a campaign's evidence brings its row to the top of the page and follows the page while the drawer opens; a host whose fixed header covers the top of the page sets scroll-padding-top on its scroll container."
        ]
      }
    },
    "vehicle-warranty-timeline": {
      "wireContract": "adp.vehicle-warranty-timeline.v1",
      "supportedLocales": ["en", "ar", "ku", "ru"],
      "host": {
        "properties": ["baseUrl", "language", "coreOnly", "disableVinValidation", "queryString"],
        "methods": ["fetchVin"],
        "owns": ["lookup request", "response handling", "loading and error state", "warranty coverage rendering"]
      },
      "runtimeAssets": {
        "locales": "dist/locales",
        "notes": ["Warranty coverage only. Campaign rendering, reCAPTCHA and unauthorized campaign lookup belong to vehicle-ssc."]
      }
    },
    "vehicle-claimable-items": {
      "wireContract": "adp.vehicle-claimable-items.v1",
      "supportedLocales": ["en", "ar", "ku", "ru"],
      "host": {
        "properties": ["baseUrl", "coreOnly", "disableVinValidation", "language", "queryString", "showTrace"],
        "methods": ["fetchVin"],
        "owns": ["lookup request", "response handling", "loading and error state", "claimable-item rendering"]
      },
      "runtimeAssets": {
        "locales": "dist/locales",
        "notes": [
          "claim, completeClaim, activate, claimEndPoint, and document-upload settings are mutation integration features. They remain raw API metadata until their host contract is reviewed."
        ]
      }
    }
  }
}
