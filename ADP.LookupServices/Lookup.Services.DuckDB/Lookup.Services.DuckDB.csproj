<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\GlobalSettings.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Authors>Shift Software</Authors>
		<Version>$(ADPVersion)</Version>
		<IsPackable>True</IsPackable>
		<PackageIcon>icon.png</PackageIcon>
		<PackageId>ShiftSoftware.ADP.Lookup.Services.DuckDB</PackageId>
		<AssemblyName>ShiftSoftware.ADP.Lookup.Services.DuckDB</AssemblyName>
		<RootNamespace>ShiftSoftware.ADP.Lookup.Services.DuckDB</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.5" />
		<PackageReference Include="Parquet.Net" Version="6.0.3" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
		<PackageReference Include="ShiftSoftware.ShiftEntity" Version="2026.8.30.1" />
		<PackageReference Include="ShiftSoftware.ADP.Lookup.Services" Version="$(ADPVersion)" Condition="!Exists('..\Lookup.Services\Lookup.Services.csproj')" />
		<!-- Hawta (bulk-lookup.md D9): the bulk engine reads a Hawta store or a published set through
		     its manifest and bookkeeping contract. Source when the sibling project is on disk, the
		     package of the same ADP version otherwise — the toggle every ADP project uses. -->
		<PackageReference Include="ShiftSoftware.ADP.Hawta" Version="$(ADPVersion)" Condition="!Exists('..\..\ADP.Hawta\Hawta\Hawta.csproj')" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Lookup.Services\Images\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Lookup.Services\Lookup.Services.csproj" Condition="Exists('..\Lookup.Services\Lookup.Services.csproj')" />
		<ProjectReference Include="..\..\ADP.Hawta\Hawta\Hawta.csproj" Condition="Exists('..\..\ADP.Hawta\Hawta\Hawta.csproj')" />
	</ItemGroup>
</Project>
