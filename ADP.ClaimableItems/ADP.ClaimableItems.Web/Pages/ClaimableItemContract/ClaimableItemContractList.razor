@attribute [Authorize]
@attribute [Route($"/{nameof(ClaimableItemContractList)}")]

@using ShiftSoftware.ShiftIdentity.Core.DTOs.Company
@using ShiftSoftware.ShiftIdentity.Core.DTOs.CompanyBranch

@inject IOptions<ClaimableItemsWebOptions> CIOptions

<ShiftList EntitySet="@(CIOptions.Value.ResolvedRoutePrefix + "ClaimableItemContract")"
           Title="Service Contracts"
           T="ClaimableItemContractListDTO"
           Context="listContext"
           Dense
           DisableActionColumn
           ComponentType="typeof(ClaimableItemContractForm)"
           ShowIDColumn="true"
           HighlightSortedColumn
           TypeAuthAction="CIOptions.Value.ClaimableItemContractsAction"
           FilterPanelDefaultOpen
           EnableFilterPanel
           EnableExport>

    <Sort Property="x => x.StartDate" Direction="SortDirection.Descending" />

    <StringFilter Order="0" Property="x => x.VIN" Label="VIN" Operator="ShiftSoftware.ShiftBlazor.Enums.ODataOperator.Contains" lg="4" md="6" sm="12" xs="12" />
    <StringFilter Order="1" Property="x => x.CustomerName" Label="Customer" Operator="ShiftSoftware.ShiftBlazor.Enums.ODataOperator.Contains" lg="4" md="6" sm="12" xs="12" />
    <StringFilter Order="2" Property="x => x.CustomerPhone" Label="Phone" Operator="ShiftSoftware.ShiftBlazor.Enums.ODataOperator.Contains" lg="4" md="6" sm="12" xs="12" />
    <DateTimeFilter Order="3" Property="x => x.StartDate" Label="Start Date" lg="4" md="6" sm="12" xs="12" />
    <DateTimeFilter Order="4" Property="x => x.EndDate" Label="End Date" lg="4" md="6" sm="12" xs="12" />
    <EnumFilter Order="5" Property="x => x.ContractType" Label="Contract Type" lg="4" md="6" sm="12" xs="12" />
    <EnumFilter Order="6" Property="x => x.IsDraft" Label="Draft" lg="4" md="6" sm="12" xs="12" />
    <EnumFilter Order="7" Property="x => x.IsCancelled" Label="Cancelled" lg="4" md="6" sm="12" xs="12" />
    <ForeignFilter @ref="CompanyFilter" Order="8" AdditionalParameters='new() { [nameof(ShiftAutocomplete<ClaimableItemContractListDTO>.GroupSelectedValues)] = false }' Property="x => x.CompanyID" Label="Company" DTOType="typeof(CompanyListDTO)" EntitySet="IdentityCompany" BaseUrlKey="ShiftIdentityApi" lg="4" md="6" sm="12" xs="12" />
    <ForeignFilter Order="9" AdditionalParameters='new() { [nameof(ShiftAutocomplete<ClaimableItemContractListDTO>.GroupSelectedValues)] = false }' Property="x => x.CompanyBranchID" AutocompleteFilter="x => x.Add(CompanyFilter?.Filter)" Label="Branch" DTOType="typeof(CompanyBranchListDTO)" EntitySet="IdentityCompanyBranch" BaseUrlKey="ShiftIdentityApi" lg="4" md="6" sm="12" xs="12" />

    <PropertyColumn Filterable="false" Property="x => x.VIN" Title="VIN" CellClass="whitespace-nowrap" HeaderClass="whitespace-nowrap" />
    <PropertyColumn Filterable="false" Property="x => x.ModelDescription" Title="Model" CellClass="whitespace-nowrap" HeaderClass="whitespace-nowrap" />
    <PropertyColumn Filterable="false" Property="x => x.CustomerName" Title="Customer" CellClass="whitespace-nowrap" HeaderClass="whitespace-nowrap" />
    <PropertyColumn Filterable="false" Property="x => x.CustomerPhone" Title="Phone" CellClass="whitespace-nowrap" HeaderClass="whitespace-nowrap" />
    <PropertyColumn Filterable="false" Property="x => x.ContractType" Title="Contract Type" CellClass="whitespace-nowrap" HeaderClass="whitespace-nowrap" />
    <PropertyColumn Filterable="false" Format="yyyy-MM-dd" Property="x => x.StartDate" Title="Start Date" HeaderClass="whitespace-nowrap" />
    <PropertyColumn Filterable="false" Format="yyyy-MM-dd" Property="x => x.EndDate" Title="End Date" HeaderClass="whitespace-nowrap" />
    <PropertyColumn Filterable="false" Format="#,0.00" Property="x => x.Total" Title="Total" HeaderClass="whitespace-nowrap" />
    <PropertyColumn Filterable="false" Format="#,0.00" Property="x => x.TotalWithIncrement" Title="Customer Total" HeaderClass="whitespace-nowrap" />

    <PropertyColumn Filterable="false" Sortable="false" Property="x => x.Status" Title="Status" Class="whitespace-nowrap">
        <CellTemplate>
            <ClaimableItemContractStatusChip Status="context.Item.Status" EndDate="context.Item.EndDate" />
        </CellTemplate>
    </PropertyColumn>

    <ForeignColumn Title="Company"
                   T="ClaimableItemContractListDTO"
                   CellClass="whitespace-nowrap"
                   Filterable="false"
                   TEntity="CompanyListDTO"
                   EntitySet="IdentityCompany"
                   BaseUrlKey="ShiftIdentityApi"
                   TProperty="string"
                   Property="x => x.CompanyID" />

    <ForeignColumn Title="Branch"
                   T="ClaimableItemContractListDTO"
                   CellClass="whitespace-nowrap"
                   Filterable="false"
                   TEntity="CompanyBranchListDTO"
                   EntitySet="IdentityCompanyBranch"
                   BaseUrlKey="ShiftIdentityApi"
                   TProperty="string"
                   Property="x => x.CompanyBranchID" />
</ShiftList>

@code {
    public ForeignFilter<ClaimableItemContractListDTO, string?>? CompanyFilter { get; set; }
}
