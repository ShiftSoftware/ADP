<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>ShiftSoftware.ADP.ClaimableItems.Sample.SingleCountry.API</RootNamespace>
		<UserSecretsId>3f6c2b1e-8a47-4d1f-9c55-5b0e7a2d4c11</UserSecretsId>
		<NoWarn>$(NoWarn);NU1903;NU1608;NU1900</NoWarn>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
		<PackageReference Include="ShiftSoftware.ShiftIdentity.AspNetCore" Version="2026.11.8.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\..\ADP.ClaimableItems.API\ADP.ClaimableItems.API.csproj" />
		<ProjectReference Include="..\ADP.ClaimableItems.Sample.SingleCountry.Web\ADP.ClaimableItems.Sample.SingleCountry.Web.csproj" />
	</ItemGroup>

</Project>
