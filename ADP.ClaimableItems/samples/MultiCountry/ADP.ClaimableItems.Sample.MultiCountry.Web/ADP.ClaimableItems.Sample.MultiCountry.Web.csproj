    <PackageReference Include="ShiftSoftware.ShiftIdentity.Blazor" Version="2026.11.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\ADP.ClaimableItems.Web\ADP.ClaimableItems.Web.csproj" />
  </ItemGroup>

</Project>
