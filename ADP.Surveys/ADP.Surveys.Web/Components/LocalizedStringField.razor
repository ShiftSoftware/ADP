@namespace ShiftSoftware.ADP.Surveys.Web.Components
@using System.Linq.Expressions
@using System.Text.Json
@using ShiftSoftware.ShiftBlazor.Services
@using LocalizedString = ShiftSoftware.ADP.Surveys.Shared.DTOs.LocalizedString
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Adapter around ShiftBlazor's LocalizedTextField. The ShiftBlazor component
   binds to a JSON-encoded `string` ({"en":"...","ar":"..."}); our schema uses
   LocalizedString : Dictionary<string,string>. This adapter round-trips
   dict <-> JSON on each edit so the visual editor can bind TheItem.Title etc.
   directly. Languages are derived from the declared Survey.Locales list.

   ReadOnly falls back to a parallel-per-locale MudTextField grid so values
   remain visible but uneditable — LocalizedTextField has no ReadOnly of its own.

   Personalization: when a PersonalizationScope cascades in, an insert menu sits
   above the field (TokenInsertMenu — variables and earlier answers). Insertion
   happens at the caret via token-insert.js rather than by rewriting Value — see
   that file for why.

   External changes: LocalizedTextField's inner LocalizedInput reads Value only in
   OnInitialized, so a Value that changes underneath it — a different option bound
   to this row after a reorder, another screen selected into the inspector, a Raw
   JSON edit — never reaches the visible boxes, and the next keystroke commits the
   stale text onto the new object. The field therefore remounts the inner component
   whenever the incoming Value differs from what it last emitted itself; its own
   edits round-trip through ValueChanged and come back equal, so typing never
   remounts (a remount would lose the caret). *@

@if (ReadOnly)
{
    <div class="lsf-readonly-grid">
        @foreach (var code in effectiveLocales)
        {
            var label = Label is null ? code.ToUpperInvariant() : $"{Label} ({code.ToUpperInvariant()})";
            var v = Value is not null && Value.TryGetValue(code, out var text) ? text : string.Empty;
            <MudTextField T="string"
                          Label="@label"
                          Value="@v"
                          ReadOnly="true"
                          Lines="Lines"
                          Class="lsf-readonly-field" />
        }
    </div>
}
else
{
    <div class="lsf" @ref="fieldRoot">
        @if (ShowTokenMenu)
        {
            <div class="lsf__token-bar">
                <TokenInsertMenu Scope="@Scope" PreferLabels="true" OnInsert="InsertToken" />
            </div>
        }

        <LocalizedTextField @key="remountKey"
                            Value="@JsonValue"
                            ValueChanged="OnTextChanged"
                            Label="@Label"
                            Languages="languageInfos"
                            Lines="Lines"
                            MaxLines="MaxLines"
                            AutoGrow="AutoGrow" />
    </div>
}

<style>
    .lsf-readonly-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 8px;
        margin: 4px 0 10px;
    }

    /* The menu button rides in normal flow above the field group, pulled down by a
       negative margin so it eats the group's own top gap instead of adding a row —
       these fields stack densely in the inspectors. Deliberately NOT absolutely
       positioned over the field: LocalizedTextField lays its locales out in a
       MudGrid whose floating labels sit exactly where an overlay would land, and
       the collision would depend on locale count and column width. */
    .lsf {
        position: relative;
    }
    .lsf__token-bar {
        display: flex;
        justify-content: flex-end;
        margin-bottom: -10px;
        position: relative;
        z-index: 2;
    }
</style>

@code {
    [Parameter]
    public LocalizedString? Value { get; set; }

    [Parameter]
    public EventCallback<LocalizedString?> ValueChanged { get; set; }

    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Locale codes to render side-by-side (typically Survey.Locales).
    /// Defaults to just "en" when null/empty.
    /// </summary>
    [Parameter]
    public List<string>? Locales { get; set; }

    [Parameter]
    public int Lines { get; set; } = 1;

    [Parameter]
    public int MaxLines { get; set; } = 1;

    [Parameter]
    public bool AutoGrow { get; set; } = false;

    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>
    /// Personalization vocabulary for this survey, supplied by the form. Absent on
    /// forms that have no notion of an instance to personalize from (the screen-template
    /// editor, the question bank), where the menu simply doesn't render.
    /// </summary>
    [CascadingParameter]
    public PersonalizationScope? Scope { get; set; }

    /// <summary>
    /// Opt out for fields where a token would be meaningless — an option's stored
    /// value, a unit suffix. Titles, descriptions, help and labels all keep it.
    /// </summary>
    [Parameter]
    public bool AllowTokens { get; set; } = true;

    bool ShowTokenMenu => AllowTokens && !ReadOnly && Scope is { IsEmpty: false };

    string JsonValue { get; set; } = "";
    List<LanguageInfo> languageInfos = new();
    List<string> effectiveLocales = new();
    List<string> currentLocales = new();

    // Identity of the inner LocalizedTextField. Bumped when Value changes from the
    // outside (see the header note) so Blazor mounts a fresh instance that reads it.
    int remountKey;
    // Canonical form of the value the inner component currently holds: what it was
    // last mounted with, or what it last emitted. Null until the first parameter set.
    string? knownValue;

    ElementReference fieldRoot;
    TokenInsertInterop? tokenInsert;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!ShowTokenMenu) return;
        tokenInsert ??= new TokenInsertInterop(JS);
        await tokenInsert.TrackAsync(fieldRoot);
    }

    Task InsertToken(string token) =>
        tokenInsert?.InsertAsync(fieldRoot, token) ?? Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (tokenInsert is null) return;
        await tokenInsert.DisposeAsync();
        tokenInsert = null;
    }

    protected override void OnParametersSet()
    {
        effectiveLocales = (Locales is { Count: > 0 }) ? Locales.ToList() : new List<string> { "en" };
        if (!effectiveLocales.SequenceEqual(currentLocales))
        {
            currentLocales = effectiveLocales.ToList();
            languageInfos = effectiveLocales
                .Select(code => new LanguageInfo { CultureName = code, Label = code.ToUpperInvariant() })
                .ToList();
        }

        JsonValue = Value is null || Value.Count == 0
            ? ""
            : JsonSerializer.Serialize((Dictionary<string, string>)Value);

        var incoming = Canonical(Value);
        if (knownValue is null)
        {
            knownValue = incoming;
        }
        else if (!string.Equals(incoming, knownValue, StringComparison.Ordinal))
        {
            // Not our own edit coming back — the bound object changed. Remount so
            // the boxes show it instead of the previous object's text.
            knownValue = incoming;
            remountKey++;
        }
    }

    /// <summary>
    /// Locale-ordered, empty-pruned rendering used to compare values. Pruning
    /// matters: the field itself drops empty locales before emitting, so the
    /// parent's copy of an edit differs from the inner component's raw state only
    /// by those blanks — that must not read as an external change.
    /// </summary>
    static string Canonical(LocalizedString? value)
    {
        if (value is null || value.Count == 0) return "";
        var pruned = new SortedDictionary<string, string>(StringComparer.Ordinal);
        foreach (var kv in value)
            if (!string.IsNullOrEmpty(kv.Value)) pruned[kv.Key] = kv.Value;
        return pruned.Count == 0 ? "" : JsonSerializer.Serialize(pruned);
    }

    async Task OnTextChanged(string json)
    {
        LocalizedString? next = null;
        if (!string.IsNullOrWhiteSpace(json))
        {
            try
            {
                var dict = JsonSerializer.Deserialize<Dictionary<string, string>>(json);
                if (dict is not null)
                {
                    // Drop empty values so serialization matches schema expectations.
                    var pruned = dict.Where(kv => !string.IsNullOrEmpty(kv.Value))
                                     .ToDictionary(kv => kv.Key, kv => kv.Value);
                    if (pruned.Count > 0)
                        next = new LocalizedString(pruned);
                }
            }
            catch (JsonException)
            {
                // LocalizedTextField always emits valid JSON; swallow defensively.
            }
        }
        // Remember what we emitted so the parent echoing it back is not mistaken
        // for an external change.
        knownValue = Canonical(next);
        await ValueChanged.InvokeAsync(next);
    }
}
