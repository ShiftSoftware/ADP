@namespace ShiftSoftware.ADP.Surveys.Web.Components.QuestionEditors
@using ShiftSoftware.ADP.Surveys.Shared.DTOs.Questions.Options
@using ShiftSoftware.ADP.Surveys.Shared.DTOs.Screens
@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    Editor for a choice question's optionsSource — the "fetch options from a
    public API" alternative to authoring options inline. The fetch happens in
    the respondent's browser (Accept-Language = survey locale), so the endpoint
    must be public and CORS-open; this block ships in the public schema.

    Every request field may carry personalization tokens: the URL, parameter and
    header values, and the POST body. {{recipient.*}} / {{candidate.*}} are filled
    when the survey is served, {{answers.<id>}} in the respondent's browser right
    before the fetch — which is how one question's endpoint can depend on an
    earlier answer. The insert menu in the section header writes a token at the
    caret of whichever field was last focused (token-insert.js, tracked on the
    whole section), the same mechanism the localized fields use.
*@

<div class="qte-section" @ref="editorRoot">
    <div class="qte-section__head">
        <div class="qte-section__title">External options (API)</div>
        @if (Value is not null && !ReadOnly)
        {
            <TokenInsertMenu Scope="@Scope"
                             PreferLabels="false"
                             Tooltip="Insert a variable or an earlier answer into the focused field (URL, parameter, header or body)"
                             OnInsert="InsertToken" />
        }
    </div>

    <MudSwitch T="bool"
               Value="@(Value is not null)"
               ValueChanged="OnToggle"
               Label="Fetch options from an API"
               Color="Color.Primary"
               Size="Size.Small"
               Disabled="@ReadOnly" />

    @if (Value is not null)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="my-2 ose-hint">
            Options are fetched in the respondent's browser when this screen is shown, with
            <code>Accept-Language</code> set to the active survey locale. The endpoint must be
            public and CORS-open — never put secrets here. Authored options above take
            precedence when both are present. The URL, parameters, headers and body can carry
            <code>@("{{variables}}")</code> and <code>@("{{answers.question-id}}")</code> —
            an unanswered or missing one is sent empty.
        </MudAlert>

        <div class="ose-request">
            <MudSelect T="string"
                       Label="Method"
                       Value="@EffectiveMethod"
                       ValueChanged="@((string v) => OnMethodChanged(v))"
                       ReadOnly="@ReadOnly"
                       Class="ose-method">
                <MudSelectItem T="string" Value="@("GET")">GET</MudSelectItem>
                <MudSelectItem T="string" Value="@("POST")">POST</MudSelectItem>
            </MudSelect>
            <MudTextField T="string"
                          Label="Endpoint URL"
                          Value="@Value.Url"
                          ValueChanged="@((string v) => OnFieldChanged(() => Value.Url = v ?? ""))"
                          ReadOnly="@ReadOnly"
                          Placeholder="https://…/api/public/company-branch"
                          HelperText="Absolute http(s) URL returning a JSON array. Tokens in the path or query are URL-encoded when filled."
                          Class="ose-url" />
        </div>

        <KeyValueListEditor Title="Query parameters"
                            Value="@Value.QueryParams"
                            ValueChanged="@((Dictionary<string, string>? v) => OnFieldChanged(() => Value.QueryParams = v))"
                            ReadOnly="@ReadOnly"
                            KeyPlaceholder="services"
                            ValuePlaceholder="body-and-paint"
                            EmptyText="No query parameters." />

        <KeyValueListEditor Title="Headers"
                            Value="@Value.Headers"
                            ValueChanged="@((Dictionary<string, string>? v) => OnFieldChanged(() => Value.Headers = v))"
                            ReadOnly="@ReadOnly"
                            KeyPlaceholder="X-Public-Key"
                            ValuePlaceholder="value"
                            EmptyText="No extra headers (Accept-Language is sent automatically)." />

        @if (Value.IsPost)
        {
            <MudTextField T="string"
                          Label="Content type"
                          Value="@Value.ContentType"
                          ValueChanged="@((string v) => OnFieldChanged(() => Value.ContentType = Blank(v)))"
                          ReadOnly="@ReadOnly"
                          Placeholder="@OptionsSourceDto.DefaultBodyContentType"
                          HelperText="Sent as Content-Type. Also decides how filled tokens are escaped: JSON-escaped for application/json, URL-encoded for a form body, as-is otherwise."
                          Class="mt-1" />
            <MudTextField T="string"
                          Label="Body"
                          Value="@Value.Body"
                          ValueChanged="@((string v) => OnFieldChanged(() => Value.Body = Blank(v)))"
                          ReadOnly="@ReadOnly"
                          Lines="4"
                          Placeholder="@BodyPlaceholder"
                          HelperText="Sent verbatim after the tokens are filled. Write the quotes yourself — a filled token is escaped for the content type, never quoted."
                          Class="ose-body mt-1" />
        }

        <div class="ose-paths">
            <MudTextField T="string"
                          Label="Items path"
                          Value="@Value.ItemsPath"
                          ValueChanged="@((string v) => OnFieldChanged(() => Value.ItemsPath = Blank(v)))"
                          ReadOnly="@ReadOnly"
                          Placeholder="(response is the array)"
                          Class="ose-path" />
            <MudTextField T="string"
                          Label="Value path"
                          Value="@Value.ValuePath"
                          ValueChanged="@((string v) => OnFieldChanged(() => Value.ValuePath = Blank(v)))"
                          ReadOnly="@ReadOnly"
                          Placeholder="ID"
                          Class="ose-path" />
            <MudTextField T="string"
                          Label="Label path"
                          Value="@Value.LabelPath"
                          ValueChanged="@((string v) => OnFieldChanged(() => Value.LabelPath = Blank(v)))"
                          ReadOnly="@ReadOnly"
                          Placeholder="Name"
                          Class="ose-path" />
        </div>

        @if (ShowNextScreen)
        {
            <MudSelect T="string"
                       Label="Next screen for every fetched option"
                       Value="@(Value.NextScreen ?? "")"
                       ValueChanged="@((string v) => OnFieldChanged(() => Value.NextScreen = Blank(v)))"
                       ReadOnly="@ReadOnly"
                       HelperText="Fetched options can't route individually — selecting any of them goes here."
                       Class="mt-2">
                <MudSelectItem T="string" Value="@("")">(not set)</MudSelectItem>
                @foreach (var (sid, index) in ScreenIdsNumbered())
                {
                    <MudSelectItem T="string" Value="@sid">@($"{index + 1}. {sid}")</MudSelectItem>
                }
            </MudSelect>
        }
    }
</div>

<style>
    /* .qte-section is also declared by MultiChoiceQuestionEditor — declared here
       too so the section styling holds when this editor renders without it. */
    .qte-section { margin-top: 14px; padding-top: 10px; border-top: 1px dashed #e0e5ec; }
    .qte-section__title { font-size: 0.8rem; font-weight: 600; color: #4b5563; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px; }
    .qte-section__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }
    .qte-section__head .qte-section__title { margin-bottom: 0; }
    .ose-hint {
        font-size: 0.8rem;
    }
    .ose-request {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        margin-bottom: 8px;
    }
    .ose-method {
        flex: 0 0 96px;
    }
    .ose-url {
        flex: 1 1 auto;
        min-width: 0;
    }
    .ose-body textarea {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.85rem;
    }
    .ose-paths {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 4px;
    }
    .ose-path {
        flex: 1 1 140px;
        min-width: 130px;
    }
</style>

@code {
    [Parameter]
    public OptionsSourceDto? Value { get; set; }

    [Parameter]
    public EventCallback<OptionsSourceDto?> ValueChanged { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>navigationList only — exposes the shared nextScreen picker.</summary>
    [Parameter]
    public bool ShowNextScreen { get; set; }

    /// <summary>Needed for the nextScreen picker's screen-id choices.</summary>
    [Parameter]
    public SurveyDto? Draft { get; set; }

    /// <summary>
    /// Personalization vocabulary, cascaded by the survey form. Absent on forms with
    /// no instance to personalize from (question bank, screen templates) — the insert
    /// menu simply doesn't render there; tokens typed by hand still work.
    /// </summary>
    [CascadingParameter]
    public PersonalizationScope? Scope { get; set; }

    ElementReference editorRoot;
    TokenInsertInterop? tokenInsert;

    string EffectiveMethod => Value?.IsPost == true ? "POST" : "GET";

    const string BodyPlaceholder = """{"vin": "{{candidate.vin}}", "branch": "{{answers.branch}}"}""";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Value is null || ReadOnly || Scope is not { IsEmpty: false }) return;
        tokenInsert ??= new TokenInsertInterop(JS);
        await tokenInsert.TrackAsync(editorRoot);
    }

    Task InsertToken(string token) =>
        tokenInsert?.InsertAsync(editorRoot, token) ?? Task.CompletedTask;

    async Task OnToggle(bool enabled)
    {
        if (enabled == (Value is not null)) return;
        await ValueChanged.InvokeAsync(enabled ? new OptionsSourceDto() : null);
    }

    async Task OnMethodChanged(string method)
    {
        if (Value is null) return;
        var post = string.Equals(method, "POST", StringComparison.OrdinalIgnoreCase);
        // GET is the default and stays implicit in the schema; a body cannot travel on it.
        Value.Method = post ? "POST" : null;
        if (!post)
        {
            Value.Body = null;
            Value.ContentType = null;
        }
        await ValueChanged.InvokeAsync(Value);
    }

    async Task OnFieldChanged(Action mutation)
    {
        mutation();
        await ValueChanged.InvokeAsync(Value);
    }

    static string? Blank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    IEnumerable<(string Id, int Index)> ScreenIdsNumbered() =>
        (Draft?.Screens ?? new List<ScreenDto>())
            .Select((s, i) => (s, i))
            .Where(t => t.s is InlineScreenDto inline && !string.IsNullOrWhiteSpace(inline.Id))
            .Select(t => (((InlineScreenDto)t.s).Id, t.i));

    public async ValueTask DisposeAsync()
    {
        if (tokenInsert is null) return;
        await tokenInsert.DisposeAsync();
        tokenInsert = null;
    }
}
