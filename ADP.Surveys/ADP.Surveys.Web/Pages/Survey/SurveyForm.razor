@attribute [Route($"{SurveyRoutes.Prefix}/{nameof(SurveyForm)}/{{Key?}}")]
@attribute [Authorize]
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using ShiftSoftware.ADP.Surveys.Shared.DTOs.Screens

@inherits ShiftForm<SurveyForm, SurveyAdminDTO>

@inject SurveysWebOptions SurveysOptions
@inject SurveyService SurveySvc
@inject MudBlazor.ISnackbar Snackbar

@*
    Two-column page: ShiftEntityForm on the left owns the editor; the phone
    preview lives OUTSIDE the form in a sticky right column so it stays
    pinned as the form scrolls. Both share TheItem via the component class
    (ShiftEntityForm.@bind-Value populates it before the outer markup reads
    it).

    The General/Visual/Logic/Triggers/Raw switch lives in the form's toolbar
    end slot as icon buttons with tooltips, next to Responses and Publish. The
    framework's own title and icon are hidden (CSS below) so the row is only
    the framework's controls (edit / maximize / close) plus ours — the header
    collapses everything into an overflow menu the moment it doesn't fit, and
    the text version did not fit in the popup. Name is edited on the General
    tab rather than inline in the header for the same reason.
*@

<div class="survey-form-page">
    <div class="survey-form-page__main">
        <ShiftEntityForm @bind-Mode="Mode"
                         @bind-Value="TheItem"
                         @ref="FormContainer"
                         Endpoint="@($"{SurveysOptions.ResolvedRoutePrefix}Survey")"
                         Title="Survey"
                         T="SurveyAdminDTO"
                         TypeAuthAction="SurveysOptions.SurveysAction"
                         OnInvalidSubmit="@OnInvalidSubmit"
                         OnValidSubmit="@OnValidSubmit"
                         @bind-Key="@Key">

            <ToolbarEndTemplate>
                <div class="survey-form__toolbar-end">
                    @*
                        Icon-only view switch. The framework header hides everything in an
                        overflow menu when its contents don't fit the row, and the text
                        version did not fit once the popup's preview column took its share —
                        so every control here is a 40px icon with a tooltip, and the
                        framework's title + icon are hidden by CSS to make room.
                    *@
                    <div class="survey-form__views" role="group" aria-label="Editor view">
                        @ViewButton("general", Icons.Material.Filled.Settings, "General")
                        @ViewButton("visual", Icons.Material.Filled.ViewModule, "Visual editor")
                        @ViewButton("logic", Icons.Material.Filled.Bolt, "Logic rules", TheItem?.Draft?.Logic?.Count ?? 0)
                        @ViewButton("triggers", Icons.Material.Filled.NotificationsActive, "Triggers", TheItem?.Draft?.Triggers?.Count ?? 0)
                        @ViewButton("raw", Icons.Material.Filled.Code, "Raw JSON")
                    </div>

                    @if (Mode != FormModes.Create && Key is not null)
                    {
                        <MudDivider Vertical="true" FlexItem="true" Class="survey-form__toolbar-divider" />
                        <MudTooltip Text="Instances & responses">
                            <MudIconButton Icon="@Icons.Material.Filled.Quiz"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           aria-label="Instances & responses"
                                           Href="@($"{SurveyRoutes.Prefix}/{nameof(SurveyResponses)}/{Key}")" />
                        </MudTooltip>
                        <MudTooltip Text="@PublishTooltip">
                            <MudIconButton Icon="@Icons.Material.Filled.Publish"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           aria-label="@PublishTooltip"
                                           Disabled="@publishing"
                                           OnClick="OnPublish" />
                        </MudTooltip>
                    }
                </div>
            </ToolbarEndTemplate>

            <ChildContent Context="formCtx">
                @*
                    Seed DraftJson once from TheItem.Draft — reliable here because
                    we're in the render pass where TheItem is already populated via
                    ShiftEntityForm's @bind-Value. OnParametersSet + OnResult proved
                    unreliable for this timing. The flag is one-shot so the user's
                    Raw-JSON edits aren't clobbered on re-render.
                *@
                @{
                    if (!draftJsonSeeded && TheItem?.Draft is not null)
                    {
                        DraftJson = SurveyDraftFactory.ToEditorJson(TheItem.Draft);
                        draftJsonSeeded = true;
                    }
                    var isReadOnly = Mode == FormModes.View;
                }

                @if (validationErrors.Count > 0)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-2 survey-form__validation-alert">
                        <div class="survey-form__validation-title">Save blocked — please fix:</div>
                        <ul class="survey-form__validation-list">
                            @foreach (var msg in validationErrors)
                            {
                                <li>@msg</li>
                            }
                        </ul>
                    </MudAlert>
                }

                @*
                    Personalization vocabulary for every LocalizedStringField below —
                    cascaded rather than threaded through a dozen editors. See
                    PersonalizationScope for why.
                *@
                <CascadingValue Value="@CurrentPersonalizationScope()" IsFixed="false">

                @if (currentView == "general")
                {
                    <GeneralTab Item="TheItem"
                                DraftChanged="OnDraftMutatedFromVisual"
                                ReadOnly="@isReadOnly"
                                SchemaVersion="schemaVersion" />
                }
                else if (currentView == "visual")
                {
                    <div class="survey-form__visual">
                        <div class="survey-form__visual-column survey-form__visual-screens">
                            <ScreenList Draft="TheItem.Draft"
                                        DraftChanged="OnDraftMutatedFromVisual"
                                        SelectedIndex="selectedScreenIndex"
                                        SelectedIndexChanged="OnSelectedScreenChanged"
                                        ReadOnly="@isReadOnly"
                                        SchemaVersion="schemaVersion" />
                        </div>
                        <div class="survey-form__visual-column survey-form__visual-inspector">
                            <ScreenInspector Draft="TheItem.Draft"
                                             DraftChanged="OnDraftMutatedFromVisual"
                                             SelectedIndex="selectedScreenIndex"
                                             ReadOnly="@isReadOnly"
                                             SchemaVersion="schemaVersion" />
                        </div>
                    </div>
                }
                else if (currentView == "logic")
                {
                    <LogicRulesPanel Draft="TheItem.Draft"
                                     DraftChanged="OnDraftMutatedFromVisual"
                                     ReadOnly="@isReadOnly"
                                     SchemaVersion="schemaVersion" />
                }
                else if (currentView == "triggers")
                {
                    <TriggersPanel Draft="TheItem.Draft"
                                   DraftChanged="OnDraftMutatedFromVisual"
                                   ReadOnly="@isReadOnly"
                                   SchemaVersion="schemaVersion" />
                }
                else
                {
                    <div class="survey-form__raw">
                        <textarea class="survey-form__editor-textarea"
                                  rows="28"
                                  spellcheck="false"
                                  readonly="@isReadOnly"
                                  value="@DraftJson"
                                  @oninput="OnDraftJsonInput" />
                        <p class="survey-form__editor-help">
                            Full SurveyDto — screens, logic, locales. Saved as-is on Save; resolved + frozen on Publish.
                            Editing here updates the Visual editor and the preview on each keystroke.
                        </p>

                        @if (parseError is not null)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
                                JSON parse error: @parseError
                            </MudAlert>
                        }
                    </div>
                }

                </CascadingValue>
            </ChildContent>
        </ShiftEntityForm>
    </div>

    @*
        Phone preview lives outside the form so it can stick to the viewport
        while the form body scrolls. TheItem comes from the base component
        class (populated by ShiftEntityForm's @bind-Value above) — null on
        first render until data loads.
    *@
    <aside class="survey-form-page__preview" aria-label="Live preview">
        <div class="survey-form-page__preview-sticky">
            <SurveyPreview Schema="@TheItem?.Draft"
                           SchemaVersion="schemaVersion"
                           ActiveScreenId="@SelectedScreenPreviewId"
                           ActiveScreenToken="@screenJumpToken" />
        </div>
    </aside>
</div>

<style>
    /*
        ShiftEntityForm hard-codes a pa-6 wrapper (24px all sides)
        around the form body — see ShiftEntityForm.razor line 227. We
        scope an override so it only affects THIS form, trimming vertical
        padding to nothing and horizontal to 12px so the editor gets the
        full card width. Framework feature request F2 in STATUS.md asks
        to make this padding configurable upstream.
    */
    .survey-form-page .pa-6 {
        padding-top: 4px !important;
        padding-bottom: 4px !important;
        padding-left: 12px !important;
        padding-right: 12px !important;
    }

    /*
        ShiftEntityForm sets an EXPLICIT pixel height on both its outer
        wrapper (an HTML5 article element) and the inner MudPaper. That
        height equals the inner form's own height — but the Save/Cancel
        toolbar is rendered as a sibling of the form, NOT inside it. So
        the toolbar visually overflows the paper's fixed height (about
        48px). Overflow is visible, so the toolbar paints and extends
        the document's scroll area — but the paper's clientHeight stays
        stuck at the form's height, which means the outer grid row (and
        therefore the right grid cell that contains our sticky phone
        preview) is 48px shorter than the true scroll area. The sticky
        then releases early, clipping the phone at the bottom of the
        page. Letting the wrapper and paper size to their full content
        (toolbar included) aligns the grid row with the document scroll.
        We use "> *" for the wrapper because it carries no CSS class we
        can target, and a plain element-name selector here trips up the
        Razor compiler.
    */
    .survey-form-page__main > * {
        height: auto !important;
        min-height: 0 !important;
    }
    .survey-form-page__main .mud-paper.mud-elevation-25 {
        height: auto !important;
        min-height: 0 !important;
    }


    /*
        Root grid: editor on the left, sticky preview on the right.
        Single column on narrow viewports — preview stacks below.
        Deliberately NO align-items: start — the right column MUST stretch
        to match the left column's grown height so position: sticky has
        travel distance when the editor body grows past the viewport. With
        align-items: start the right cell collapses to the preview's
        intrinsic height and sticky has nowhere to travel.
    */
    .survey-form-page {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }
    @@media (min-width: 1024px) {
        /* Right column auto-sizes to the phone's current width so the
           editor reclaims the space that used to sit on either side of
           a narrower device. Because the phone is width: fit-content
           and shrinks with the viewport height, this column also shrinks. */
        .survey-form-page {
            grid-template-columns: minmax(0, 1fr) auto;
        }
    }

    .survey-form-page__main {
        min-width: 0;
    }

    .survey-form-page__preview {
        min-width: 0;
    }

    /*
        position: sticky must live on a direct child of the scroll
        ancestor that can actually move. The top value clears the MudBlazor
        AppBar (64px default in the ADP shell) plus a little breathing room,
        otherwise the phone's rounded top hides behind the fixed bar when
        the user scrolls. Flex-center so the now-width-fitted device sits
        horizontally centered in the column instead of left-aligned.
    */
    .survey-form-page__preview-sticky {
        position: sticky;
        top: 72px;
        display: flex;
        justify-content: center;
    }

    /*
        Modal mode. ShiftEntityForm marks its scroll container with
        .shift-scrollable-content-wrapper only when the form is hosted in a
        dialog, which makes it a reliable "am I in a modal?" signal from CSS
        for anything INSIDE the form body (the Screens rail). Inside a dialog
        the AppBar is not overhead — the dialog's own header toolbar is, and
        it already sits ABOVE this scroller — so the 72px clearance the page
        layout needs is just dead space at the top of the rail. 8px keeps it
        off the edge. The phone lives outside the form (see the aside below),
        so its modal rules key off .mud-dialog instead.
    */
    .shift-scrollable-content-wrapper .survey-form__visual-screens {
        top: 8px;
    }
    /* The phone's cell is the dialog's height and does not scroll with the
       form body (it sits outside the form), so there is nothing to stick to. */
    .mud-dialog .survey-form-page__preview-sticky {
        position: static;
    }

    /*
        Header row. The framework renders its icon + title first; both are
        hidden here — the end slot needs the width, and the row is recognisable
        without them. The end slot is icon buttons only, so the framework's
        overflow menu (it hides the whole slot the moment it doesn't fit) has no
        reason to kick in at any width the editor is usable at.
    */
    .survey-form-page .shift-toolbar-header > svg.mud-icon-root:first-child,
    .survey-form-page .shift-toolbar-header > p.mud-typography {
        display: none;
    }
    /* The framework's dense toolbar is 48px; a count badge overhangs its
       button by ~6px and was clipped against the top edge. 56px gives the
       36px buttons 10px of air on both sides. */
    .survey-form-page .shift-toolbar-header {
        min-height: 56px;
    }
    .survey-form__toolbar-end {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: nowrap;
    }
    .survey-form__views {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    /* Small icons (20px) on 36px buttons — lighter than the framework's own
       24-on-40 controls beside them, still a comfortable target. MudBlazor
       pads a text icon button and a filled one differently; one size for the
       row, so the selected view doesn't shrink. */
    .survey-form__toolbar-end .mud-icon-button {
        width: 36px;
        height: 36px;
        padding: 8px;
    }
    .survey-form__toolbar-divider {
        margin: 0 4px;
    }

    /*
        Popup (modal) mode. The dialog is a bounded flex column with
        overflow: hidden, and the framework gives its own form pieces (article,
        paper, form, .form-body) min-height: 0 + flex: 1 so the body scrolls
        inside it. That chain used to break at this page's grid, which sat
        between the dialog and the article with a content-sized minimum height:
        the grid grew to the editor's full height, the dialog clipped it, and
        nothing scrolled. Bounding the grid to the dialog and making the main
        cell a flex column hands the constraint down to the article, so the
        form body is the scroller again — with the Screens rail sticky inside
        it and the phone pinned in its own cell, exactly as on the page.
    */
    .mud-dialog .survey-form-page {
        flex: 1 1 auto;
        min-height: 0;
        grid-template-rows: minmax(0, 1fr);
    }
    .mud-dialog .survey-form-page__main {
        min-height: 0;
        display: flex;
        flex-direction: column;
    }
    .mud-dialog .survey-form-page__main > * {
        flex: 1 1 auto;
    }
    .mud-dialog .survey-form-page__preview {
        min-height: 0;
        overflow-y: auto;
    }

    /* Visual editor body: Screens rail + Inspector. No align-items: start
       at the grid level so the screens grid CELL stretches to the row
       height; the screens column itself uses align-self: start to stay
       intrinsic-height inside that stretched cell, which is what lets
       position: sticky have travel room. */
    .survey-form__visual {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
    }
    @@media (min-width: 640px) {
        .survey-form__visual {
            grid-template-columns: 240px minmax(0, 1fr);
        }
    }

    /* Screens column sticks at the same top offset as the phone preview
       (72px — clears the AppBar) so both pinned rails line up. Internal
       scroll on this container + unbounding ScreenList's built-in
       max-height keeps a single scroller for long screen lists rather
       than nested ones. */
    .survey-form__visual-screens {
        position: sticky;
        top: 72px;
        align-self: start;
        max-height: calc(100dvh - 88px);
        overflow-y: auto;
    }
    /* In a modal the dialog has already eaten 176px of the viewport's height
       budget before this scroller starts (MudBlazor's 64px appbar-height gutter
       on .mud-dialog + the form's 48px dense header toolbar + its 64px footer
       toolbar), plus the 8px sticky offset above. */
    .shift-scrollable-content-wrapper .survey-form__visual-screens {
        max-height: calc(100dvh - 190px);
    }
    .survey-form__visual-screens .screen-list__items {
        max-height: none;
        overflow-y: visible;
    }

    /* Raw JSON editor — takes the full width. */
    .survey-form__raw {
        display: flex;
        flex-direction: column;
    }

    .survey-preview__placeholder {
        padding: 32px;
        text-align: center;
        color: #888;
    }
    .survey-form__editor-textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 12px;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        font-family: ui-monospace, "Cascadia Code", Menlo, Consolas, monospace;
        font-size: 0.85rem;
        line-height: 1.5;
        resize: vertical;
    }
    .survey-form__editor-textarea:focus-visible {
        outline: 2px solid #2563eb;
        outline-offset: 1px;
        border-color: #2563eb;
    }
    .survey-form__editor-help {
        margin: 4px 0 0;
        font-size: 0.8rem;
        color: #666;
    }

    .survey-form__validation-title {
        font-weight: 600;
        margin-bottom: 4px;
    }
    .survey-form__validation-list {
        margin: 0;
        padding-left: 18px;
        font-size: 0.85rem;
    }
</style>

@code {
    string DraftJson { get; set; } = "";
    string? parseError;
    bool publishing;
    // Validation-summary rows shown in a top-of-form MudAlert whenever a save
    // attempt fails. Includes errors on fields that aren't bound via `For=`
    // (e.g. Draft.Screens, Draft.Title) so users see what's blocking the save
    // instead of clicking Save and getting nothing.
    List<string> validationErrors = new();
    int selectedScreenIndex = -1;

    /// <summary>
    /// Increments on every screen-row click. Paired with <see cref="SelectedScreenPreviewId"/>
    /// so a re-click of the already-selected screen still reads as a new jump request.
    /// </summary>
    int screenJumpToken;
    // "general" | "visual" | "logic" | "raw" — toggled via the MudToggleGroup
    // in the toolbar end slot. Defaults to General on Create (Key is null) and
    // Visual on Edit so returning to a survey lands on the builder surface.
    string currentView = "visual";
    // Counter bumped on every Draft mutation so SurveyPreview detects content
    // changes even when the SurveyDto reference is reused. Reference-equality
    // alone would miss in-place field edits from the visual editor.
    int schemaVersion;
    // Tracks whether we've seeded DraftJson from TheItem.Draft yet. After the
    // user touches the textarea OR the visual editor, DraftJson is re-derived
    // from TheItem.Draft on each mutation — never clobbered mid-edit because
    // the mutation source IS TheItem.Draft.
    bool draftJsonSeeded;

    // Cached personalization vocabulary. Rebuilding it means a reflection walk over
    // the whole draft to collect the tokens already written in the copy — cheap, but
    // not cheap enough to redo on every render of a form this size. Keyed on the
    // mutation counter AND the draft reference so a freshly-loaded survey doesn't
    // keep the empty scope built before its data arrived.
    PersonalizationScope? scopeCache;
    SurveyDto? scopeDraft;
    int scopeVersion = -1;

    PersonalizationScope CurrentPersonalizationScope()
    {
        var draft = TheItem?.Draft;
        if (scopeCache is null || scopeVersion != schemaVersion || !ReferenceEquals(scopeDraft, draft))
        {
            scopeCache = PersonalizationScope.FromDraft(draft);
            scopeDraft = draft;
            scopeVersion = schemaVersion;
        }
        return scopeCache;
    }

    protected override void OnInitialized()
    {
        if (Mode == FormModes.Create || Key is null)
            currentView = "general";
    }

    /// <summary>
    /// Widens the hosting dialog past the app-wide modal-size preference (Large,
    /// 1280px by default) as soon as the form mounts. The builder puts three
    /// columns side by side — screens rail, inspector, phone preview — and at
    /// 1280px the preview rail is pushed outside the dialog's own paper. Ignored
    /// when the form is opened as a page: no dialog to resize.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!firstRender) return;

        var dialog = FormContainer?.MudDialog;
        if (dialog is null) return;

        await dialog.SetOptionsAsync(dialog.Options with
        {
            // MaxWidth.False is the widest option MudBlazor offers — it drops the
            // pixel cap entirely, leaving the dialog at the viewport minus a 64px
            // gutter (every named size, up to ExtraExtraLarge's 2560px, caps
            // narrower than that on a normal display).
            MaxWidth = MaxWidth.False,
            FullWidth = true,
        });
    }

    void OnDraftJsonInput(ChangeEventArgs e)
    {
        OnDraftJsonChanged((e.Value as string) ?? "");
    }

    void OnDraftJsonChanged(string value)
    {
        DraftJson = value;
        if (string.IsNullOrWhiteSpace(value))
        {
            TheItem.Draft = null;
            parseError = null;
            if (selectedScreenIndex >= 0) selectedScreenIndex = -1;
            schemaVersion++;
            return;
        }
        try
        {
            TheItem.Draft = SurveyDraftFactory.FromEditorJson(value);
            parseError = null;
            ClampSelection();
            schemaVersion++;
        }
        catch (JsonException ex)
        {
            parseError = ex.Message;
        }
    }

    // Visual editor mutated the Draft. Re-serialize so Raw JSON stays in sync,
    // bump the schema version so the preview sees the change.
    void OnDraftMutatedFromVisual(SurveyDto? draft)
    {
        if (draft is not null
            && draft.Title.Count == 0
            && !string.IsNullOrWhiteSpace(TheItem?.Name)
            && draft.Locales.Count > 0)
        {
            // Seed Title from Name on first materialize so a user who just
            // types a Name and adds a screen still produces a valid survey.
            draft.Title[draft.Locales[0]] = TheItem.Name;
        }
        TheItem.Draft = draft;
        DraftJson = SurveyDraftFactory.ToEditorJson(draft);
        parseError = null;
        ClampSelection();
        schemaVersion++;
    }

    void OnSelectedScreenChanged(int index)
    {
        selectedScreenIndex = index;

        // Bumped on every selection click, not just changes of screen. The preview jumps
        // on a change of (id, token), so re-clicking the already-selected row still pulls
        // the preview back to it.
        screenJumpToken++;
    }

    /// <summary>
    /// Resolved-schema id of the editor's selected screen, pushed to the
    /// preview as a jump signal. Inline screens keep their Id; template refs
    /// resolve to a screen whose id IS the template key. Null when nothing is
    /// selected — the preview navigates freely.
    /// </summary>
    string? SelectedScreenPreviewId
    {
        get
        {
            var screens = TheItem?.Draft?.Screens;
            if (screens is null || selectedScreenIndex < 0 || selectedScreenIndex >= screens.Count)
                return null;
            return screens[selectedScreenIndex] switch
            {
                InlineScreenDto inline when !string.IsNullOrWhiteSpace(inline.Id) => inline.Id,
                ScreenTemplateRefDto tref when !string.IsNullOrWhiteSpace(tref.TemplateRef) => tref.TemplateRef,
                _ => null,
            };
        }
    }

    void ClampSelection()
    {
        var count = TheItem?.Draft?.Screens.Count ?? 0;
        if (selectedScreenIndex >= count) selectedScreenIndex = count - 1;
        if (selectedScreenIndex < 0 && count > 0) selectedScreenIndex = 0;
    }

    void OnInvalidSubmit(ShiftSoftware.ShiftBlazor.Utils.ShiftEvent<EditContext> e)
    {
        var ctx = e.Data;
        validationErrors = ctx.GetValidationMessages()
            .Distinct()
            .ToList();
        if (validationErrors.Count == 0)
            validationErrors.Add("Form is invalid but no detailed message was produced.");
    }

    void OnValidSubmit(ShiftSoftware.ShiftBlazor.Utils.ShiftEvent<EditContext> e)
    {
        // Clear any prior error summary once the form validates.
        if (validationErrors.Count > 0) validationErrors.Clear();
    }

    /// <summary>
    /// One icon button of the view switch: filled when it is the current view,
    /// a small badge with the count when the view has content worth knowing
    /// about (logic rules, triggers). Tooltip carries the name — the header is
    /// icons only, see the markup comment.
    /// </summary>
    RenderFragment ViewButton(string view, string icon, string label, int count = 0) => @<MudTooltip Text="@label">
        <MudBadge Content="@count" Visible="@(count > 0)" Color="Color.Info" Overlap="true" Bordered="true" Origin="Origin.TopRight">
            <MudIconButton Icon="@icon"
                           Size="Size.Small"
                           Color="@(currentView == view ? Color.Primary : Color.Default)"
                           Variant="@(currentView == view ? Variant.Filled : Variant.Text)"
                           aria-label="@label"
                           aria-pressed="@(currentView == view ? "true" : "false")"
                           OnClick="@(() => currentView = view)" />
        </MudBadge>
    </MudTooltip>;

    /// <summary>The Publish tooltip doubles as the place the published version is read now that the header chip is gone.</summary>
    string PublishTooltip => publishing
        ? "Publishing…"
        : TheItem?.PublishedVersionNumber is { } v ? $"Publish (currently v{v})" : "Publish (not published yet)";

    async Task OnPublish()
    {
        var idString = Key?.ToString();
        if (string.IsNullOrEmpty(idString)) return;
        publishing = true;
        try
        {
            var response = await SurveySvc.PublishAsync(idString);
            var body = await response.Content.ReadAsStringAsync();
            if (response.IsSuccessStatusCode)
                Snackbar.Add($"Published — {body}", MudBlazor.Severity.Success);
            else
                Snackbar.Add($"Publish failed: {body}", MudBlazor.Severity.Error);
        }
        finally
        {
            publishing = false;
        }
    }
}
