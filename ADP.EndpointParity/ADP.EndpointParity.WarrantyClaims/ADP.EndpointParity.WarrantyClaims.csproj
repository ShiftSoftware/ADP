<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  TEMPORARY - deleted in Step 08. One of five thin per-group parity projects.

	  Group selection is a COMPILE-TIME boundary, not a runtime test filter. This project
	  references ONLY the harness plus WarrantyClaims's own projects, so while any OTHER group is
	  mid-migration (its `: Profile` classes deleted before their replacements are wired) this
	  project still builds and WarrantyClaims stays verifiable. A single test project referencing all
	  five groups' .Data would be unbuildable for the whole of whichever group step is in
	  flight - which is exactly when the instrument is most needed. See verification.md section 2.

	  Host mode: MOUNTED HOST - no sample host exists. Booted through AddWarrantyClaimsApiServices<ParityDb>. Highest-risk group in the repo; also carries a dedicated mapper-level golden for the five distributor-side members.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<OutputType>Exe</OutputType>
		<AssemblyName>ADP.EndpointParity.WarrantyClaims</AssemblyName>
		<RootNamespace>ShiftSoftware.ADP.EndpointParity.WarrantyClaims</RootNamespace>
		<NoWarn>$(NoWarn);NU1903;NU1608</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit.v3" Version="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ADP.EndpointParity.Harness\ADP.EndpointParity.Harness.csproj" />
		<ProjectReference Include="..\..\ADP.WarrantyClaims\ADP.WarrantyClaims.API\ADP.WarrantyClaims.API.csproj" />
		<ProjectReference Include="..\..\ADP.WarrantyClaims\ADP.WarrantyClaims.Data\ADP.WarrantyClaims.Data.csproj" />
	</ItemGroup>

</Project>
