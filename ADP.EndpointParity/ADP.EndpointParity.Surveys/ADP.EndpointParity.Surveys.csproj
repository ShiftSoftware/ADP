<Project Sdk="Microsoft.NET.Sdk">

	<!--
	  TEMPORARY - deleted in Step 08. One of five thin per-group parity projects.

	  Group selection is a COMPILE-TIME boundary, not a runtime test filter. This project
	  references ONLY the harness plus ADP.Surveys' own API/Data, so while any OTHER group is
	  mid-migration (its `: Profile` classes deleted before their replacements are wired) this
	  project still builds and Surveys stays verifiable. A single test project referencing all
	  five groups' .Data would be unbuildable for the whole of whichever group step is in
	  flight - which is exactly when the instrument is most needed. See verification.md 2.
	-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<OutputType>Exe</OutputType>
		<AssemblyName>ADP.EndpointParity.Surveys</AssemblyName>
		<RootNamespace>ShiftSoftware.ADP.EndpointParity.Surveys</RootNamespace>
		<NoWarn>$(NoWarn);NU1903;NU1608</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="xunit.v3" Version="3.2.2" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ADP.EndpointParity.Harness\ADP.EndpointParity.Harness.csproj" />
		<!-- The sample host this group boots, and through it ADP.Surveys.{API,Data}. -->
		<ProjectReference Include="..\..\ADP.Surveys\samples\ADP.Surveys.Sample.API\ADP.Surveys.Sample.API.csproj" />
	</ItemGroup>

</Project>
