<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\GlobalSettings.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<RootNamespace>ShiftSoftware.ADP.SyncAgent</RootNamespace>
		<Authors>Shift Software</Authors>
		<AssemblyName>ShiftSoftware.ADP.SyncAgent</AssemblyName>
		<PackageId>ShiftSoftware.ADP.SyncAgent</PackageId>
		<Version>$(ADPVersion)</Version>
		<IsPackable>True</IsPackable>
		<PackageIcon>icon.png</PackageIcon>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Services\CosmosCSVSyncService.cs" />
		<Compile Remove="Services\SyncService2.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Storage.Blobs" Version="12.30.1" />
		<PackageReference Include="Azure.Storage.Files.Shares" Version="12.28.0" />
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="EFCore.BulkExtensions.SqlServer" Version="10.0.1" />
		<PackageReference Include="LibGit2Sharp" Version="0.32.0" />
		<PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.2" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
		<!-- Pinned above the vulnerable version SqlClient pulls in transitively (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
		<PackageReference Include="Polly" Version="8.8.0" />
		<PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.6.1" />
		<PackageReference Include="ShiftSoftware.ADP.Models" Version="$(ADPVersion)" Condition="!Exists('..\..\ADP.Models\Models\Models.csproj')" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Images\icon.png" Pack="true" PackagePath="\" />
		<Folder Include="Images\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\ADP.Models\Models\Models.csproj" Condition="Exists('..\..\ADP.Models\Models\Models.csproj')" />
	</ItemGroup>
</Project>
