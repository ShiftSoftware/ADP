@attribute [Route($"{DarlasticRoutes.Prefix}/{nameof(CaseBrowser)}")]
@attribute [Authorize]
@inject HttpClient Http
@inject IJSRuntime JS
@inject IOptions<DarlasticWebOptions> DarlasticOptionsAccessor
@implements IAsyncDisposable

@*
    The case browser, embedded.

    The tool itself is a single static HTML page served by ADP.Darlastic.API — the same one the
    standalone resolver serves, not a copy — showing the evidence behind a cluster: the records that
    merged, the edges that joined them, and the flags and label audits stewards left on the way. It
    predates the module and it is not Blazor, so it cannot be a component here; what this page does
    is get a steward into it as themselves, and keep them there.

    "As themselves" is the part that takes work. A browser navigating to a static page sends no
    bearer token, and the page has no auth stack to attach one to its own fetches, so the host mints
    a short-lived signed token and hands it over in the URL. THIS component holds the real session —
    its HttpClient runs through the app's refresh handler — so when that token nears expiry it mints
    another and posts it in. No reload, no lost place, and no refresh logic inside a page that has
    none of its own.

    The token carries the minting caller's access, so a steward with read-only rights gets a
    read-only browser rather than buttons that 403 on click.
*@

<PageTitle>Case Browser</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="my-4">@_error</MudAlert>
}
else if (_frameUrl is null)
{
    <MudProgressLinear Indeterminate Color="Color.Primary" Class="my-4" />
}
else
{
    @if (_readOnly)
    {
        <MudAlert Severity="Severity.Info" Dense Class="mb-2">
            Read-only: you can browse cases and their evidence, but flags and label decisions are not
            yours to record. Ask for write access on the steward queue if you need them.
        </MudAlert>
    }

    @* Height is set from JS once the layout is known — see fitToViewport. The inline fallback keeps
       the frame usable if that never runs (JS interop unavailable, module blocked) instead of
       collapsing it to nothing, which is what an unsized iframe does. *@
    <div id="@ContainerId" style="height:70vh;">
        <iframe id="@FrameId" src="@_frameUrl"
                style="width:100%;height:100%;border:0;display:block;"
                title="Darlastic case browser"></iframe>
    </div>
}

@code {
    const string ContainerId = "darlastic-case-browser-fit";
    const string FrameId = "darlastic-case-browser";
    const string ModulePath = "./_content/ShiftSoftware.ADP.Darlastic.Web/js/caseBrowser.js";

    private DarlasticWebOptions DarlasticOptions => DarlasticOptionsAccessor.Value;

    string? _frameUrl;
    string? _error;
    bool _readOnly;
    IJSObjectReference? _module;
    bool _moduleTried;
    Timer? _renewal;

    class TokenResponse
    {
        public string Token { get; set; } = default!;
        public string Expires { get; set; } = default!;
        public string Actor { get; set; } = default!;
        public string Url { get; set; } = default!;
        public int LifetimeSeconds { get; set; }
        public bool CanWrite { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        var token = await MintAsync();
        if (token is null) return;

        _readOnly = !token.CanWrite;

        // The token endpoint hands back a host-relative URL. Resolve it against the client's own base
        // address rather than the browser's location: the API is not necessarily the origin serving
        // this SPA, and an iframe pointed at the wrong one renders a 404 page inside a working layout.
        _frameUrl = new Uri(Http.BaseAddress!, token.Url).ToString();

        ScheduleRenewal(token.LifetimeSeconds);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Not firstRender — the frame only exists once a token came back, which is a later render.
        // _moduleTried, not a _module null check: a failed import must not be retried on every
        // subsequent render for the life of the page.
        if (_frameUrl is null || _moduleTried) return;
        _moduleTried = true;

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await _module.InvokeVoidAsync("fitToViewport", ContainerId);
        }
        catch
        {
            // Sizing and renewal are both conveniences; the browser works without either, on the
            // fallback height and until the first token expires. Not worth an error banner over the
            // page the steward actually came for.
            _module = null;
        }
    }

    // Relative to HttpClient.BaseAddress, which already carries the host's "/api/" segment, and
    // prefixed with wherever the host mounted the module — the same construction every other page
    // here uses. Hard-coding "/api/Darlastic/..." would work in exactly one host and, because an
    // unmatched path falls through to the SPA fallback, would fail as a JSON parse error on '<'
    // rather than as a 404 in any other.
    private string TokenEndpoint => $"{DarlasticOptions.ResolvedRoutePrefix}CaseBrowserUi/token";

    async Task<TokenResponse?> MintAsync()
    {
        try
        {
            var response = await Http.GetAsync(TokenEndpoint);

            if (!response.IsSuccessStatusCode)
            {
                _error = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Forbidden =>
                        "You do not have access to the steward queue, which is what the case browser reads.",
                    System.Net.HttpStatusCode.NotImplemented =>
                        "The case browser is not enabled on this host — no signing key is configured for its access tokens.",
                    _ => $"Could not open the case browser: {(int)response.StatusCode} {response.ReasonPhrase}.",
                };
                return null;
            }

            var token = await response.Content.ReadFromJsonAsync<TokenResponse>();
            if (token is null) _error = "The case browser token endpoint returned nothing.";
            return token;
        }
        catch (Exception ex)
        {
            _error = $"Could not open the case browser: {ex.Message}";
            return null;
        }
    }

    void ScheduleRenewal(int lifetimeSeconds)
    {
        // Renew at 80% of the lifetime: early enough that a slow mint still lands before expiry,
        // late enough not to churn tokens for a tab someone left open.
        var every = TimeSpan.FromSeconds(Math.Max(60, lifetimeSeconds * 0.8));

        _renewal = new Timer(async _ =>
        {
            var token = await MintAsync();
            if (token is null || _module is null) return;
            try
            {
                await _module.InvokeVoidAsync("postToken", FrameId, token.Token, token.Expires, token.Actor);
            }
            catch
            {
                // The frame may be gone (navigated away) before the timer fires. Nothing to do.
            }
        }, null, every, every);
    }

    public async ValueTask DisposeAsync()
    {
        _renewal?.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("releaseViewport", ContainerId);
                await _module.DisposeAsync();
            }
            catch
            {
                // Disposal races navigation away from the page; the circuit may already be gone.
            }
        }
    }
}
