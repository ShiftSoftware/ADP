<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="..\..\GlobalSettings.props" />

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<RootNamespace>ShiftSoftware.ADP.Darlastic.Data</RootNamespace>
		<Authors>Shift Software</Authors>
		<Product>ADP.Darlastic</Product>
		<Version>$(ADPVersion)</Version>
		<AssemblyName>ShiftSoftware.ADP.Darlastic.Data</AssemblyName>
		<PackageId>ShiftSoftware.ADP.Darlastic.Data</PackageId>
		<Title>ShiftSoftware ADP.Darlastic — Data</Title>
		<Description>EF Core entity model for the ShiftSoftware ADP.Darlastic package — the golden-identity registry (identities, redirects, source profiles, projection state, resolve runs) hosts run migrations against, under a configurable SQL schema.</Description>
		<Copyright>Copyright (c) Shift Software 2026</Copyright>
		<PackageProjectUrl>https://github.com/ShiftSoftware/ADP</PackageProjectUrl>
		<PackageIcon>icon.png</PackageIcon>
		<RepositoryUrl>https://github.com/ShiftSoftware/ADP</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>shift;shiftsoftware;adp;darlastic;customers;mdm;identity;efcore</PackageTags>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<None Include="Images\icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ADP.Darlastic.Shared\ADP.Darlastic.Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- COMPATIBILITY FLOOR, not "the current version". A PackageReference version is a MINIMUM,
		     and for a module that deploys into whatever host a tenant already runs, that minimum is a
		     compatibility contract. Set it to the newest package sitting on the build machine and
		     every host that hasn't upgraded is silently excluded.

		     Measured 2026-07-30: one deployment had five candidate hosts and none was on the floor of
		     the day, so referencing Darlastic failed restore outright (NU1605: "Detected package
		     downgrade"). Raising a host to match can mean upgrades well past the Shift stack.

		     The floor is now 2026.10.7.2 (TypeAuth 1.6.30 in .Shared / .API), raised on purpose.
		     The golden-customer surfaces mask name, phone and email with the framework's PII
		     protection (PiiFieldDTO, [Pii], PiiDtoProtector, PiiOptions and the OData query guard).
		     Those types first shipped in 2026.10.5.1, so no host below that can run this module.
		     2026.10.7.2 is the version verified to build and test here. A floor between 2026.10.5.1
		     and 2026.10.7.2 is untested; lower it only with a build to prove it. Hosts above the
		     floor still resolve their own higher version, because a floor only ever widens. Raise it
		     again only when Darlastic needs a newer API, knowing that drops every host below it. -->
		<PackageReference Include="ShiftSoftware.ShiftEntity.EFCore" Version="2026.10.7.2" />
	</ItemGroup>
</Project>
